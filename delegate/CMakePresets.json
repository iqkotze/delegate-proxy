{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/../build/${presetName}",
      "cacheVariables": {
        "DG_CXX_STANDARD": "20",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "C++20, Debug with -O2 -g",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O2 -g"
      }
    },
    {
      "name": "release",
      "displayName": "C++20, -O2 with LTO",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_FLAGS_RELEASE": "-O2",
        "CMAKE_INTERPROCEDURAL_OPTIMIZATION": "ON"
      }
    },
    {
      "name": "cxx23",
      "displayName": "C++23, Debug with -O2 -g",
      "inherits": "debug",
      "cacheVariables": {
        "DG_CXX_STANDARD": "23"
      }
    },
    {
      "name": "asan",
      "displayName": "C++20, Debug with AddressSanitizer and UBSan",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "clang",
      "displayName": "C++20, Debug with clang",
      "inherits": "debug",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++"
      }
    },
    {
      "name": "ubsan-clang",
      "displayName": "C++20, Debug with clang and UBSan including the function check",
      "inherits": "clang",
      "cacheVariables": {
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined,function -fno-sanitize-recover=function -fno-omit-frame-pointer"
      }
    },
    {
      "name": "fuzz",
      "displayName": "libFuzzer targets with ASan and UBSan (clang)",
      "inherits": "clang",
      "cacheVariables": {
        "DG_BUILD_FUZZ": "ON",
        "DG_BUILD_TESTS": "OFF",
        "CMAKE_CXX_FLAGS": "-fsanitize=fuzzer-no-link,address,undefined -fno-omit-frame-pointer"
      }
    },
    {
      "name": "coverage",
      "displayName": "C++20, gcc --coverage without optimization",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS_DEBUG": "-O0 -g",
        "CMAKE_CXX_FLAGS": "--coverage",
        "CMAKE_EXE_LINKER_FLAGS": "--coverage",
        "CMAKE_CXX_COMPILER": "g++"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "cxx23",
      "configurePreset": "cxx23"
    },
    {
      "name": "asan",
      "configurePreset": "asan"
    },
    {
      "name": "clang",
      "configurePreset": "clang"
    },
    {
      "name": "ubsan-clang",
      "configurePreset": "ubsan-clang"
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz"
    },
    {
      "name": "coverage",
      "configurePreset": "coverage"
    }
  ],
  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "release",
      "configurePreset": "release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cxx23",
      "configurePreset": "cxx23",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "clang",
      "configurePreset": "clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "ubsan-clang",
      "configurePreset": "ubsan-clang",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "fuzz",
      "configurePreset": "fuzz",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "coverage",
      "configurePreset": "coverage",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
